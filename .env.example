# Copy to .env and adjust. docker compose reads this automatically.
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry
POSTGRES_DB=telemetry
POSTGRES_HOST_PORT=5433     # host port; 5432 is often taken by a local postgres
API_HOST_PORT=8080          # web UI + API

# Uncomment to start the generator on every `docker compose up` (default: postgres only)
# COMPOSE_PROFILES=generate

# Generator tuning
MODE=catchup             # catchup: fill from the newest stored reading to now, then keep up
                         # backfill: load START_DATE..END_DATE and exit; live: load test
DEVICE_COUNT=50          # devices; each has 3 sensors (temperature, humidity, pressure)
BATCH_SIZE=50000         # rows per COPY/INSERT
SAMPLE_INTERVAL_SECS=300 # one reading per sensor every 5 minutes
# TRUNCATE_ON_START=true # wipe readings before the run (default: true for backfill only)

# backfill range; catchup uses START_DATE only when the table is empty (default: 30 days ago).
# Dates are YYYY-MM-DD (midnight UTC) or RFC 3339. END_DATE defaults to now.
# START_DATE=2026-01-01
# END_DATE=2026-11-01

# live mode only
BATCH_INTERVAL_MS=500    # pause between batches (0 = flat out)
TOTAL_ROWS=0             # stop after this many rows (0 = run forever)
